# Panel giriş şifresi (en az 8 karakter). ZORUNLU.
ADMIN_PASSWORD=buraya-guclu-bir-sifre-yazin

# Panel oturumlarını imzalamak için rastgele uzun bir metin. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=buraya-64-karakterlik-rastgele-metin

# QR adresindeki şube adı: https://alanadiniz.com/cafe/<BRANCH>/masa5
BRANCH=sube1

# İlk kurulumda görünecek kafe adı (sonra panelden değiştirilebilir)
CAFE_NAME=ILNA Kafe

# Verilerin (menü, siparişler, sadakat) saklandığı klasör. Docker'da /data kalıcı diske bağlanır.
DATA_DIR=/data

# true yapılırsa ilk açılışta raporlar için 28 günlük örnek sipariş üretilir. Gerçek kafede false bırakın.
SEED_DEMO=false

# Alan adınız (yalnızca docker-compose + Caddy ile otomatik HTTPS için)
DOMAIN=menu.ornekkafe.com

NODE_ENV=production
PORT=3000
TZ=Europe/Istanbul
